# Variabel Coolify untuk infra/compose.production.yml. CONTOH TANPA NILAI RAHASIA.
# Isi nilai asli langsung di Coolify (bukan di Git). APP_KEY: php artisan key:generate --show.
APP_ENV=production
APP_URL=https://takeda.morriz.tech
API_APP_KEY=
WEB_APP_KEY=
# Neon branch production: runtime = endpoint POOLED (-pooler) role rt05_app; migration = endpoint DIRECT role pemilik.
# Wajib ?sslmode=verify-full (bukan require). Contoh bentuk:
# postgresql://rt05_app:***@ep-xxxx-pooler.c-4.ap-southeast-1.aws.neon.tech/rt05_takeda?sslmode=verify-full
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DB_RUNTIME_ROLE=rt05_app
# WAJIB untuk staging dan production. Isi di Coolify atau env server, jangan di Git.
# Compose menolak nilai kosong. Lokal/CI boleh tanpa password.
REDIS_PASSWORD=
REDIS_CACHE_PASSWORD=
# Kosongkan untuk prefix kanonik takeda:<APP_ENV>: (production → takeda:production:).
# Isi hanya jika lingkungan ini sudah memakai prefix eksplisit yang harus dipertahankan.
# REDIS_PREFIX=
RT05_ENV=production
RT05_HOST=takeda.morriz.tech
# SMTP (opsional; tanpa SMTP reset password hanya tercatat di log, belum terkirim).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@takeda.morriz.tech
