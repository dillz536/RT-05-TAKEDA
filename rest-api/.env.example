# RT05 TAKEDA REST API. Salin ke .env; jangan pernah commit .env.
APP_NAME="RT05 TAKEDA API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres. Runtime memakai DATABASE_URL (Neon: endpoint pooled, host berakhiran -pooler, role DML).
# Migration memakai DATABASE_URL_UNPOOLED (Neon: endpoint direct, role pemilik schema).
# Nilai di bawah adalah Postgres LOKAL (infra/compose.local.yml), bukan credential.
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://rt05_app:local-dev-only@127.0.0.1:54329/rt05_dev
DATABASE_URL_UNPOOLED=postgresql://rt05_migrator:local-dev-only@127.0.0.1:54329/rt05_dev
DB_CONNECT_TIMEOUT=5
# Lokal: prefer. Neon/staging/production: verify-full + sslrootcert=system (libpq >= 16) atau path CA.
# URL Neon membawa ?sslmode=require; ganti menjadi ?sslmode=verify-full&sslrootcert=system karena
# parameter URL mengalahkan DB_SSLMODE. /health/ready dan rt05:db-smoke menolak selain verify-full
# pada staging/production.
DB_SSLMODE=prefer
DB_SSLROOTCERT=

# Lokal tanpa Redis: sesi array, cache file, antrean sync (outbox diproses langsung saat
# rt05:outbox-dispatch). Staging/production: SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION=redis.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sesi cookie CMS (M06). Nama cookie terpisah dari website; Secure otomatis bila APP_URL HTTPS.
# SANCTUM_STATEFUL_DOMAINS kosong = host APP_URL (CMS satu origin lewat gateway).
SESSION_COOKIE=rt05_api_session
# SANCTUM_STATEFUL_DOMAINS=
# RT05_XSRF_COOKIE=rt05_api_xsrf
# RT05_TOKEN_FAILURES_PER_HOUR=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=file

# Redis (docs/ASYNC_JOBS.md): instance queue (antrean + lock + heartbeat, AOF, noeviction) dan
# instance cache (cache/sesi/limiter). REDIS_QUEUE_* / REDIS_CACHE_* kosong = pakai REDIS_HOST/PORT/
# PASSWORD dengan DB 0 (queue) dan 1 (cache). Prefix default takeda:<APP_ENV>:.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_QUEUE_HOST=
# REDIS_CACHE_HOST=
# REDIS_PREFIX=takeda:local:

# Outbox dan heartbeat (config/rt05.php). Nilai default sesuai rancangan; CI boleh memendekkan stale.
# RT05_OUTBOX_STALE_SECONDS=900
# RT05_OUTBOX_LEASE_SECONDS=120
# RT05_HEARTBEAT_MAX_AGE=300

# Email reset (berisi token) TIDAK PERNAH dikirim lewat transport log di environment mana pun,
# termasuk failover yang memuat log. Tanpa SMTP, lupa password tetap 202 tetapi email tidak terkirim.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@takeda.morriz.tech"
MAIL_FROM_NAME="${APP_NAME}"
